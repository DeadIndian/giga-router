{
  "name": "giga-router",
  "version": "1.1.0",
  "description": "A no-fuss router for your models, tools, and skills",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.cjs",
    "preview": "node scripts/preview.cjs",
    "build:site": "node scripts/build-site.cjs",
    "preview:site": "node scripts/preview-site.cjs",
    "test:site": "node scripts/check-site.cjs",
    "update:marketplaces": "node scripts/update-marketplaces.js",
    "update:providers": "node scripts/update-provider-models.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server-filesystem": "2025.12.18",
    "@modelcontextprotocol/server-memory": "2025.11.25",
    "@modelcontextprotocol/server-sequential-thinking": "2025.12.18",
    "eventsource-parser": "4.1.2",
    "express": "4.22.3",
    "feather-icons": "4.29.2",
    "fflate": "0.8.3",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "openai": "7.43.0"
  }
}
